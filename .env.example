# ATHARX environment configuration
# Copy this file to .env.local for local development.
# Never commit real secrets. This file only documents shape/defaults.

# --- Application ---
NEXT_PUBLIC_APP_NAME=ATHARX
NODE_ENV=development

# --- Database ---
# Path to the local SQLite file that backs the demo/mock persistence layer.
# In production this is replaced by a managed PostgreSQL/Supabase connection string.
DATABASE_FILE=./db/atharx.db
# DATABASE_URL=postgresql://user:password@host:5432/atharx

# --- Omantel Integration Adapter ---
# "mock" uses the built-in MockOmantelAdapter (no external calls).
# "production" would route through OmantelProviderAdapter once Omantel issues
# real credentials and endpoints. Never hardcode production secrets here.
OMANTEL_API_MODE=mock
OMANTEL_API_BASE_URL=https://api.example-omantel-integration.com/api/v1
OMANTEL_CLIENT_ID=
OMANTEL_CLIENT_SECRET=

# --- ATHARX Omantel Integration API (this app's own API, for Postman/testing) ---
ATHARX_API_BASE_URL=http://localhost:3000/api/v1
ATHARX_CLIENT_ID=atharx-demo-client
ATHARX_CLIENT_SECRET=atharx-demo-secret

# --- Session / security ---
# Used to sign the lightweight demo session cookie. Generate a random string
# for any real deployment; never reuse the example value.
SESSION_SECRET=replace-with-a-long-random-string

# --- Gamification configuration (server-side, admin-configurable in future) ---
VIP_COIN_THRESHOLD=65
LUCKY_DRAW_MIN_COINS=10
SPIN_COOLDOWN_SECONDS=86400
SPIN_REWARD_COINS=1
